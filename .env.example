# Copy this file to .env and fill in your values.
# The app will run in mock mode if LLM_API_KEY is not set.

LLM_API_KEY=...
# Base URL of your OpenAI-compatible LLM provider/router
LLM_BASE_URL=https://api.your-provider.example/v1
# Model to request from that provider, used by all agents
LLM_MODEL=...

# Logging: DEBUG also logs full prompts. LOG_FILE additionally writes to disk.
LOG_LEVEL=INFO
# LOG_FILE=resonance.log

# Financial Tools warehouse (read-only, used by the Stock Detail page).
# Leave unset to run the app without market data.
DATABASE_URL=postgresql://user:password@localhost:5432/corporate_db
