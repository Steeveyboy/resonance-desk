# Copy this file to .env and fill in your values.
# The app will run in mock mode if OPENAI_API_KEY is not set.

OPENAI_API_KEY=sk-...
# Optional: override the model used by all agents
OPENAI_MODEL=gpt-4o-mini

# Financial Tools warehouse (read-only, used by the Stock Detail page).
# Leave unset to run the app without market data.
DATABASE_URL=postgresql://user:password@localhost:5432/corporate_db
